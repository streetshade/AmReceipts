# Copy to terraform.tfvars and edit.

region        = "us-east-1"
instance_type = "t3.medium"   # or "t4g.medium" with architecture = "arm64"
architecture  = "amd64"

key_name = "my-ec2-keypair"   # an EXISTING EC2 key pair name
ssh_cidr = "203.0.113.4/32"   # your IP only

# App / DNS
domain            = "receipts.example.com"  # leave "" to skip TLS on first boot
letsencrypt_email = "ops@example.com"

repo_branch      = "claude/samaritech-amreceipts"
ocr_provider     = "stub"        # stub | tesseract | google-vision
barcode_provider = "upcitemdb"

# git_token = "ghp_xxx"          # only if the repo is private
