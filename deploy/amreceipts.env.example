# Production environment for AmReceipts.
# Install to /etc/amreceipts/amreceipts.env (referenced by the systemd unit).
#   sudo install -Dm600 deploy/amreceipts.env.example /etc/amreceipts/amreceipts.env
#   sudo chown amreceipts:amreceipts /etc/amreceipts/amreceipts.env
# Then edit the values below.

# --- Database (PostgreSQL recommended in production) ---
# Requires switching prisma/schema.prisma datasource provider to "postgresql".
DATABASE_URL="postgresql://amreceipts:CHANGE_ME@127.0.0.1:5432/amreceipts?schema=public"

# --- Auth ---
# Generate with: openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_TO_A_64_CHAR_HEX_STRING"

# --- OCR ---
# "google-vision" for cloud OCR, "tesseract" for on-device, "stub" for offline demo.
OCR_PROVIDER="google-vision"
GOOGLE_APPLICATION_CREDENTIALS="/etc/amreceipts/gcp-vision.json"

# --- Barcode lookup ---
# "upcitemdb" to resolve unknown barcodes online (cached to DB); "local" for seeded-only.
# On hitting the daily trial limit, lookups defer and retry 24h later.
BARCODE_PROVIDER="upcitemdb"
# UPCITEMDB_API_KEY=""

# Secret for the deferred-lookup retry endpoint (called by cron). Generate with:
#   openssl rand -hex 24
CRON_SECRET="CHANGE_ME"

NODE_ENV="production"
PORT="3000"
