# Copy to .env and adjust.

# Prisma / database. SQLite by default so the app runs with zero setup.
# For production swap to Postgres, e.g. postgresql://user:pass@host:5432/amreceipts
DATABASE_URL="file:./dev.db"

# Secret used to sign auth session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="dev-secret-change-me-0000000000000000000000000000000000000000000000"

# ---- Providers (all optional; app falls back to built-in stubs) ----

# OCR provider:
#   "stub"          deterministic offline (default, no keys)
#   "tesseract"     real on-device OCR (no external service)
#   "google-vision" real Google Cloud Vision OCR (best accuracy on receipts)
OCR_PROVIDER="stub"

# --- Google Cloud Vision (only used when OCR_PROVIDER=google-vision) ---
# Point to a service-account JSON key with the "Cloud Vision API User" role.
# Either set GOOGLE_APPLICATION_CREDENTIALS (standard, picked up automatically)
# or GOOGLE_VISION_KEY_FILE (explicit path passed to the client).
# On GCE/GKE with an attached service account, neither is required.
GOOGLE_APPLICATION_CREDENTIALS="/etc/amreceipts/gcp-vision.json"
# GOOGLE_VISION_KEY_FILE="/etc/amreceipts/gcp-vision.json"

# Barcode lookup provider: "local" (default, seeded DB only) or "upcitemdb" (online lookup, falls back to local)
BARCODE_PROVIDER="local"
# Optional key for upcitemdb "trial" endpoint works keyless at low volume.
UPCITEMDB_API_KEY=""
