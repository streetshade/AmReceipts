# Copy to .env and adjust.

# Prisma / database. SQLite by default so the app runs with zero setup.
# For production swap to Postgres, e.g. postgresql://user:pass@host:5432/amreceipts
DATABASE_URL="file:./dev.db"

# Secret used to sign auth session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="dev-secret-change-me-0000000000000000000000000000000000000000000000"

# ---- Providers (all optional; app falls back to built-in stubs) ----

# OCR provider:
#   "stub"          deterministic offline (default, no keys)
#   "tesseract"     real on-device OCR (no external service)
#   "google-vision" real Google Cloud Vision OCR (best accuracy on receipts)
OCR_PROVIDER="stub"

# --- Google Cloud Vision (only used when OCR_PROVIDER=google-vision) ---
# Point to a service-account JSON key with the "Cloud Vision API User" role.
# Either set GOOGLE_APPLICATION_CREDENTIALS (standard, picked up automatically)
# or GOOGLE_VISION_KEY_FILE (explicit path passed to the client).
# On GCE/GKE with an attached service account, neither is required.
GOOGLE_APPLICATION_CREDENTIALS="/etc/amreceipts/gcp-vision.json"
# GOOGLE_VISION_KEY_FILE="/etc/amreceipts/gcp-vision.json"

# Barcode lookup provider:
#   "upcitemdb" online lookup, falling back to (and caching into) the seeded DB
#   "local"     seeded DB only (fully offline)
BARCODE_PROVIDER="upcitemdb"
# Optional key for upcitemdb. The keyless "trial" endpoint works at low volume
# (~100 lookups/day); set a paid key here to raise the limit. When the daily
# limit is hit, lookups fail gracefully and the barcode is queued for a retry
# 24h later (when the quota resets).
UPCITEMDB_API_KEY=""

# Secret guarding POST /api/maintenance/retry-lookups (the deferred-lookup retry
# endpoint a cron can call). Defaults to AUTH_SECRET if unset.
CRON_SECRET=""

# Key for encrypting integration secrets stored via Admin -> Integrations
# (API keys, .ionapi client secret and saak/sask). Generate with:
#   openssl rand -hex 32
# If unset, a key is derived from AUTH_SECRET instead - which works, but ties
# the two together: rotating AUTH_SECRET then makes every stored integration
# secret undecryptable and they must be re-entered. Set this explicitly in
# production.
CONFIG_ENCRYPTION_KEY=""

# ---- Infor M3 / ION integration ----

# Credentials for the M3 service account, as a JSON object. The name of this
# variable is whatever `secretRef` says in the integration config (default
# M3_ION_SECRETS). Values map straight out of a backend-service .ionapi file:
#   cs -> client secret, saak -> username, sask -> password
# Keep .ionapi files out of the repo and out of any web root - they are live
# credentials. For basic auth (test grids only) use {"username":..,"password":..}
M3_ION_SECRETS=""

# Comma-separated hosts (INCLUDING port) this deployment considers production,
# e.g. "m3-grid-prod.example.com:7443". Supplied here rather than in the admin
# console on purpose: a connection labelled PRD must match this list, and a
# connection labelled DEV/TST must NOT. An allowlist an admin can edit next to
# the base URL would attest nothing. A PRD connection FAILS if this is empty.
M3_PROD_HOSTS=""

# The posting queue drain endpoint POST /api/m3/postings/drain reuses
# CRON_SECRET above. Example (every 15 minutes):
#   */15 * * * * curl -s -X POST -H "x-cron-secret: $CRON_SECRET" \
#     https://receipts.example.com/api/m3/postings/drain >/dev/null
